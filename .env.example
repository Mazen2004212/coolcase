# ============================================
# Coolcase Environment Variables
# ============================================

# Build-time public configuration (safe to expose in browser bundles)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ============================================
# Supabase
# ============================================

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Lambda runtime secret — NEVER expose via NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ============================================
# AWS Lambda runtime configuration
# ============================================

# Local default: supabase. Set to s3 in AWS Lambda.
PUBLIC_MEDIA_BACKEND=supabase
AWS_PUBLIC_MEDIA_BUCKET=

# Comma-separated hostnames, without protocols or paths.
SERVER_ACTION_ALLOWED_ORIGINS=

# Lambda runtime secret injected by CloudFront as x-coolcase-origin-verify.
AWS_ORIGIN_VERIFY_SECRET=

# AWS_REGION is supplied automatically by Lambda. Set it locally only when
# testing the S3 backend with an authorized developer identity.
# AWS_REGION=eu-central-1

# ============================================
# Email — Gmail SMTP (Backend Phase 2)
# ============================================
# Use a Gmail account with an App Password (not your regular password).
# To generate an App Password:
#   1. Enable 2-Step Verification on your Google account
#   2. Go to Google Account → Security → App Passwords
#   3. Create a new App Password for "Mail"
#
# Lambda runtime secrets/config — never expose these via NEXT_PUBLIC_.

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=your-gmail@gmail.com
EMAIL_APP_PASSWORD=your-16-char-app-password
EMAIL_FROM=your-gmail@gmail.com

# ============================================
# Optional database verification / seed scripts
# ============================================
# Keep these server-only. They are read by scripts, not by browser code.

COOLCASE_SUPABASE_URL=
COOLCASE_SUPABASE_ANON_KEY=
COOLCASE_SUPABASE_SERVICE_ROLE_KEY=
COOLCASE_EXPECTED_PROJECT_REF=
