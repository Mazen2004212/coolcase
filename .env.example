# ============================================
# Coolcase Environment Variables
# ============================================

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Coolcase

# ============================================
# Supabase
# ============================================

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY
# NEVER expose this variable through NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# ============================================
# Store
# ============================================

NEXT_PUBLIC_CURRENCY=EGP

# Do not make these the authoritative production
# pricing source long-term.
# Production prices should come from store settings.
DEFAULT_SILICONE_PRICE=150
DEFAULT_ACRYLIC_PRICE=200
DEFAULT_SHIPPING_FEE=50

# ============================================
# Optional future services
# ============================================

# Error monitoring
# SENTRY_DSN=

# Email provider
# RESEND_API_KEY=