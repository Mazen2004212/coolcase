# ============================================
# Coolcase Environment Variables
# ============================================

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Coolcase

# ============================================
# Supabase
# ============================================

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY — NEVER expose via NEXT_PUBLIC_
# Used by admin server actions for privileged catalog operations.
SUPABASE_SERVICE_ROLE_KEY=

# ============================================
# Admin
# ============================================

# Set to true ONLY for local UI development without Supabase auth.
# MUST be false or unset in production.
ADMIN_DEMO_MODE=false

# ============================================
# Store
# ============================================

NEXT_PUBLIC_CURRENCY=EGP

# ============================================
# Optional future services
# ============================================

# Error monitoring
# SENTRY_DSN=

# Email provider (for Backend Phase 2 — real order email delivery)
# RESEND_API_KEY=